menuconfig OBJZ
	bool "Objective-Z transpiler support"
	depends on CPU_CORTEX_M || CPU_CORTEX_A || (RISCV && !RISCV_ISA_RV32E)
	select STATIC_INIT_GNU
	help
	  Enable Objective-Z transpiled C support with the Platform
	  Abstraction Layer (PAL). The transpiler converts Objective-C
	  (.m) sources to plain C at build time via Clang AST analysis.

if OBJZ

# The transpiler. There used to be a choice here between the Rust pipeline
# and a Python one (oz_transpile); the Python backend is retired, so
# CONFIG_OBJZ_BACKEND_STATIC is unconditional and CONFIG_OBJZ_BACKEND_PYTHON
# no longer exists. A build that still sets it will fail Kconfig's unknown
# symbol check rather than silently selecting something else.
#
# The implementation is readable at the `python-backend-final` tag.
config OBJZ_BACKEND_STATIC
	bool
	default y
	help
	  The transpiler: .m -> tree-sitter CST -> oz2c -> .h + .c. Rejects
	  anything outside its supported subset with a located error rather
	  than emitting code that misbehaves. Reflection and @selector are
	  the notable exclusions -- see issue #226.

config OBJZ_HEAP
	bool "Enable heap-based allocation (allocWithHeap:)"
	depends on HEAP_MEM_POOL_SIZE > 0
	select SYS_HEAP_RUNTIME_STATS
	help
	  Allow objects to be allocated from an OZHeap instead of
	  k_mem_slab.  Adds +allocWithHeap: class method and
	  heap-aware free path using CONTAINER_OF.
	  Enables SYS_HEAP_RUNTIME_STATS for heap usage queries.

endif # OBJZ
