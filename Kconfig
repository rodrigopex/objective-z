menuconfig OBJZ
	bool "Objective-Z transpiler support"
	depends on CPU_CORTEX_M || CPU_CORTEX_A || (RISCV && !RISCV_ISA_RV32E)
	select STATIC_INIT_GNU
	help
	  Enable Objective-Z transpiled C support with the Platform
	  Abstraction Layer (PAL). The transpiler converts Objective-C
	  (.m) sources to plain C at build time via Clang AST analysis.

if OBJZ

choice OBJZ_BACKEND
	prompt "Transpiler backend"
	default OBJZ_BACKEND_STATIC
	help
	  Selects which .m -> C transpiler generates sources for this
	  target: the Rust pipeline (oz_static / oz2c) or the older Python
	  one (oz_transpile). Both support POOL_SIZES, heap allocation
	  (CONFIG_OBJZ_HEAP), multiple entry files and multiple include
	  directories.

	  The two are compared case by case against the shared behaviour
	  corpus by tests/tools/cross_backend.py, which runs each of its 73
	  cases through both and diffs the results; see
	  tools/oz_static/PARITY.md for what that measures and what it does
	  not. Note in particular that the Rust backend's on-target
	  behaviour is not covered by that harness, which is a host
	  comparison.

config OBJZ_BACKEND_STATIC
	bool "Rust (oz_static)"
	help
	  Rejects anything outside its supported subset with a located
	  error rather than emitting code that misbehaves. Reflection and
	  @selector are the notable exclusions -- see issues/OZ-101.md.

config OBJZ_BACKEND_PYTHON
	bool "Python (oz_transpile)"
	help
	  The original pipeline. Reads a Clang AST dump directly and emits
	  from templates.

endchoice

config OBJZ_HEAP
	bool "Enable heap-based allocation (allocWithHeap:)"
	depends on HEAP_MEM_POOL_SIZE > 0
	select SYS_HEAP_RUNTIME_STATS
	help
	  Allow objects to be allocated from an OZHeap instead of
	  k_mem_slab.  Adds +allocWithHeap: class method and
	  heap-aware free path using CONTAINER_OF.
	  Enables SYS_HEAP_RUNTIME_STATS for heap usage queries.

endif # OBJZ
